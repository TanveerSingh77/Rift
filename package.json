{
  "name": "vidgrab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Cloud video downloader. Resolves links server-side and streams media straight to the device without storing anything.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:bin": "bash render-build.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "express": "^4.21.2"
  }
}
